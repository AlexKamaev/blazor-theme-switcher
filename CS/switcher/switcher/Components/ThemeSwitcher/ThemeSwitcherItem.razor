@inject DemoThemeService ThemesService
@rendermode InteractiveServer

<a class="themeswitcher-item list-group-item list-group-item-action @(ThemesService.ActiveTheme == DemoTheme ? "active" : "text-body") @DemoTheme.Name.ToLower()"
   @onclick:preventDefault
   @onclick="Anchor_Click">
    <span>@DemoTheme.Title</span>
</a>
@code {
    [Parameter] public DemoTheme DemoTheme { get; set; }
    [Parameter] public EventCallback<DemoTheme> Click { get; set; }

    async Task Anchor_Click() {
        await Click.InvokeAsync(DemoTheme);
    }
}
